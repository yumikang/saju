# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
#
# 이 파일을 복사하여 .env.production 파일을 생성하고 실제 값을 입력하세요
# cp .env.production.template .env.production
#
# ⚠️  WARNING: .env.production 파일은 절대 Git에 커밋하지 마세요!
# =============================================================================

# App Configuration
NODE_ENV=production
APP_URL=https://saju-naming.one-q.xyz
SOCKET_PORT=3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# 프로덕션 PostgreSQL 데이터베이스 연결 문자열
# 형식: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@host:5432/saju_naming_prod?schema=public"

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# 프로덕션 Redis 서버 (세션 & 캐시)
REDIS_URL=redis://:your_redis_password@redis-host:6379/0
REDIS_PASSWORD=your_strong_redis_password

# =============================================================================
# TOSSPAYMENTS CONFIGURATION (PRODUCTION)
# =============================================================================
#
# 🔴 CRITICAL: 반드시 실제(live) 키를 사용하세요!
#
# TossPayments 개발자센터에서 발급받은 실제 API 키:
# https://developers.tosspayments.com/
#
# 키 형식:
# - Client Key: live_ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# - Secret Key: live_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
TOSS_CLIENT_KEY=live_ck_REPLACE_WITH_REAL_CLIENT_KEY
TOSS_SECRET_KEY=live_sk_REPLACE_WITH_REAL_SECRET_KEY

# =============================================================================
# SESSION SECRET (PRODUCTION)
# =============================================================================
#
# 🔴 CRITICAL: 강력한 랜덤 문자열 필수 (최소 32자)
#
# 생성 방법:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_SECRET_USER=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# OpenAI API 키 (GPT-4 이름 추천에 사용)
OPENAI_API_KEY=sk-REPLACE_WITH_REAL_OPENAI_KEY

# =============================================================================
# SUPABASE CONFIGURATION (선택)
# =============================================================================
# Supabase 사용 시 설정
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# MONITORING & ANALYTICS (선택)
# =============================================================================
# Sentry DSN (에러 추적)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Google Analytics (선택)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# 대기열 처리 용량
QUEUE_PROCESSING_CAPACITY=10
QUEUE_AVG_PROCESSING_TIME=30

# =============================================================================
# EMAIL CONFIGURATION (선택)
# =============================================================================
# 이메일 전송 서비스 (결제 영수증, 알림 등)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# SECURITY HEADERS (권장)
# =============================================================================
# CORS 허용 도메인
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=900000

# =============================================================================
# DEPLOYMENT INFO (선택)
# =============================================================================
# 배포 환경 정보
# DEPLOY_ENV=production
# DEPLOY_REGION=ap-northeast-2
# DEPLOY_VERSION=1.0.0
